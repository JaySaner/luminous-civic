{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores citizen profile and authentication details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["citizen", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Report": {
      "title": "Civic Report",
      "description": "Detailed record of a civic issue reported by a citizen.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "UID of the reporting citizen" },
        "name": { "type": "string", "description": "Reporter's full name" },
        "address": { "type": "string", "description": "Incident location address" },
        "email": { "type": "string", "format": "email" },
        "description": { "type": "string", "description": "Citizen's detailed problem description" },
        "issueType": { "type": "string" },
        "location": { "type": "string", "description": "AI-detected coordinates or landmark" },
        "authority": { "type": "string", "description": "Target municipal department" },
        "legalComplaint": { "type": "string" },
        "preview": { "type": "string", "description": "Base64 or URL of evidence image" },
        "status": { "type": "string", "enum": ["Processing", "Authority Notified", "Unit Assigned", "Resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "address", "issueType", "authority", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Global collection of all civic reports."
    }
  }
}
